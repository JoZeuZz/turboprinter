    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "0.469.0",
    "motion": "^12.42.2",
    "multer": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.28.0",
    "zustand": "^4.5.6"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
